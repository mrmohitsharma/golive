# Domain pointing at this VM (A record). Caddy gets a Let's Encrypt certificate for it.
PUBLIC_DOMAIN=live.cogolfers.com
# The VM's public IPv4 (used in WebRTC ICE candidates).
PUBLIC_IP=203.0.113.10
# Optional: host phones/OBS use for SRT if different from PUBLIC_DOMAIN.
PUBLIC_SRT_HOST=

# Generate each secret with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
DATA_KEY=
MEDIAMTX_HOOK_SECRET=
INTERNAL_MEDIA_PASS=

# Anyone can create an account and a club from the app. Set to false for a closed server.
SIGNUP_ENABLED=true

# Public website and legal pages. Google (YouTube OAuth verification) and Meta (app review)
# read /privacy and /terms, and Google Play asks for /delete-account, so fill these in.
BRAND_NAME=Go Live
SUPPORT_EMAIL=support@icca.co.in
# Registered company name and address exactly as on your incorporation documents
LEGAL_ENTITY=
LEGAL_ADDRESS=
LEGAL_JURISDICTION=Gurugram, Haryana
# Grievance Officer (IT Rules 2021 / DPDP Act 2023): a named person who answers complaints
GRIEVANCE_OFFICER=
# Change this date whenever you change the terms or privacy policy
LEGAL_UPDATED=27 October 2026
# Store links shown on the account page after sign-up (optional)
PLAY_STORE_URL=
APP_STORE_URL=

# Optional SRT AES encryption (10-79 letters/digits). Leave empty to disable.
SRT_PASSPHRASE=
# SRT latency (ms). 600 suits 4G on a golf course; raise to 1000-1500 on poor networks.
SRT_LATENCY_MS=600
# How long camera recordings (for replays and clips) are kept. Clips are kept until deleted.
RECORDING_RETENTION=72h

# YouTube "Connect" (optional). Google Cloud Console > APIs & Services:
#   enable "YouTube Data API v3", create an OAuth client of type "Web application",
#   authorised redirect URI: https://<PUBLIC_DOMAIN>/api/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Google: Web,Android,iOS OAuth client IDs (docs/DEPLOYMENT.md 3h). Empty = no Google button.
GOOGLE_SIGNIN_CLIENT_IDS=

# Facebook Page live (optional). developers.facebook.com > My Apps > Create app (Business),
#   add "Facebook Login for Business", Valid OAuth redirect URI: https://<PUBLIC_DOMAIN>/api/facebook/callback,
#   permissions pages_show_list, pages_read_engagement, pages_manage_posts, pages_read_user_content (App Review for other clubs' Pages).
META_APP_ID=
META_APP_SECRET=

# Viewer comments: YouTube live chat is read every N seconds while live (5 YouTube API units
# per read). At 15 s a 5-hour show uses ~8,600 of the default 10,000 units/day including the
# broadcast status checks; ask Google for more quota to run more shows a day. Facebook every 4 s.
YOUTUBE_CHAT_POLL_SEC=15
FACEBOOK_COMMENTS_POLL_SEC=4
# Extra words to mask in the chat (comma-separated)
CHAT_BLOCKED_WORDS=

# Instagram has no API: directors paste the stream URL + key from instagram.com before each event.
# The server re-encodes a 9:16 version for it at this bitrate (kbps).
INSTAGRAM_VIDEO_KBPS=3500

# Public watch page (https://<PUBLIC_DOMAIN>/watch/<tournament>) and its API for the CoGolfers
# website. Origins allowed to call /api/public/* from the browser, and to embed the page in an iframe.
PUBLIC_CORS_ORIGINS=https://cogolfers.com,https://www.cogolfers.com
WATCH_EMBED_ORIGINS=https://cogolfers.com,https://www.cogolfers.com

# Billing. Each tournament gets free cameras and free live minutes; extra cameras and further
# minutes are paid from the club's credit wallet. Prices and credit packs are set at
# https://<PUBLIC_DOMAIN>/admin by a CoGolfers administrator. false = no limits at all.
BILLING_ENABLED=true

# Cashfree payment gateway (clubs buy credits by UPI/card/net banking). merchant.cashfree.com >
#   Developers > API keys. Webhook URL: https://<PUBLIC_DOMAIN>/api/payments/cashfree/webhook
#   (Payment success/failed events). Leave empty until ready: CoGolfers staff can add credits in /admin.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# sandbox while testing, production for real money
CASHFREE_ENV=sandbox

# Cloud production (OBS on this server instead of a venue laptop): none | docker
# docker: build the engine image first:  docker compose --profile build build cloud-engine
CLOUD_ENGINE_DRIVER=none
# Group id of the host's docker group:  getent group docker | cut -d: -f3
DOCKER_GID=999
# Per-engine resources. 1080p30 x264 + 10 camera decodes needs ~6 vCPU.
CLOUD_ENGINE_CPUS=6
CLOUD_ENGINE_MEMORY_MB=6144
# Stop an engine after this many minutes with nothing live.
CLOUD_ENGINE_IDLE_STOP_MIN=30
# Shown to directors next to "Start cloud engine" (your cost, in USD/hour).
CLOUD_ENGINE_COST_PER_HOUR=0.35

# First admin account (platform admin + "CoGolfers" organisation), created on first start only.
BOOTSTRAP_ADMIN_EMAIL=admin@cogolfers.com
BOOTSTRAP_ADMIN_PASSWORD=

# Join links open the app (docs/DEPLOYMENT.md 3i)
ANDROID_PACKAGE=com.cogolfers.cogolfer_live
ANDROID_CERT_SHA256=
IOS_APP_ID=

# SMS through MSG91 (docs/DEPLOYMENT.md 3j). Empty = test sender (messages only logged).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_REMINDER=
MSG91_TEMPLATE_WINNER=
MSG91_TEMPLATE_DRAW=

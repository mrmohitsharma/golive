{
  "name": "cogolfer-live-server",
  "version": "0.1.0",
  "private": true,
  "description": "CoGolfer Live Director backend: auth, tournaments, camera registry, MediaMTX auth hook, stream health, thumbnails and real-time control hub.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "node dist/seed-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.4",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "ws": "^8.22.0"
  }
}

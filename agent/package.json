{
  "name": "cogolfer-obs-agent",
  "version": "0.1.0",
  "private": true,
  "description": "The Go Live agent: runs next to OBS Studio (a laptop at the venue, or the cloud engine) and lets directors switch the programme remotely.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cogolfer-obs-agent": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "e2e": "node --import tsx e2e/pipeline.e2e.ts",
    "apps": "node scripts/build-apps.mjs"
  },
  "dependencies": {
    "obs-websocket-js": "^5.0.8",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@yao-pkg/pkg": "^6.25.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "werift": "^0.25.1"
  }
}

# Copy these three from the app: Tournament > Production > Engine setup (.env)
SERVER_URL=https://live.cogolfers.com
TOURNAMENT_ID=
ENGINE_KEY=

# OBS > Tools > WebSocket Server Settings: enable, note port and password
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=

# Optional. Not needed when the organisation connected YouTube in the app (the server then
# creates the broadcast and sends OBS the stream key). Otherwise: YouTube Studio > Go live > Stream key.
YOUTUBE_STREAM_KEY=
# YOUTUBE_SERVER=rtmps://a.rtmps.youtube.com:443/live2

FALLBACK_TEXT=We'll be right back
